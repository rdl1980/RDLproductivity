{
  "manifest_version": 3,
  "name": "RDL KDP Sync",
  "version": "1.0.2",
  "description": "Aggiorna libri e vendite KDP in RDL Productivity con un clic, dal browser in cui sei collegato a KDP.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://kdp.amazon.com/*",
    "https://kdpreports.amazon.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://rdlproductivity.vercel.app/*", "http://localhost:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
