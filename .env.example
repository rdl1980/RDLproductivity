# Database (Neon / Supabase / Postgres locale)
DATABASE_URL="postgresql://user:password@localhost:5432/rdlproductivity"

# Auth.js
AUTH_SECRET=""            # genera con: pnpm dlx auth secret
AUTH_URL="http://localhost:3000"

# GitHub OAuth app, callback: <AUTH_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth client, redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Utente autorizzato: un indirizzo o più indirizzi separati da virgola
ALLOWED_EMAIL=""

# Allegati: in produzione Vercel Blob (store privato, BLOB_READ_WRITE_TOKEN creato da Vercel).
# In locale e nei test i file vanno in .data/attachments:
NEXT_PUBLIC_ATTACHMENT_STORAGE="local"
# BLOB_READ_WRITE_TOKEN=""
