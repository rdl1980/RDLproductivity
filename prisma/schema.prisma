generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(cuid())
  title     String
  color     String?
  position  String // fractional index
  archived  Boolean  @default(false)
  lists     List[]
  labels    Label[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model List {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  position  String // fractional index
  archived  Boolean  @default(false)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, position])
}

model Card {
  id            String        @id @default(cuid())
  listId        String
  list          List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  title         String
  description   String? // markdown
  position      String // fractional index
  startDate     DateTime?
  dueDate       DateTime?
  completed     Boolean       @default(false)
  /// When the card was last completed (statistics); null while open.
  completedAt   DateTime?
  /// When the card entered its current list (time-in-list statistics).
  listEnteredAt DateTime      @default(now())
  /// 0 (highest) to 4 (lowest); null = no priority. Checked in the database.
  priority      Int?
  /// { rule, interval, timeZone }: completing the card creates the next occurrence.
  recurrence    Json?
  coverId       String?       @unique
  cover         Attachment?   @relation("CardCover", fields: [coverId], references: [id], onDelete: SetNull)
  attachments   Attachment[]  @relation("CardAttachments")
  kdpBookLinks  KdpBookLink[]
  archived      Boolean       @default(false)
  labels        CardLabel[]
  checklists    Checklist[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([listId, position])
  @@index([dueDate])
  @@index([priority])
  @@index([completedAt])
}

model Label {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String
  cards   CardLabel[]

  @@index([boardId])
}

model CardLabel {
  cardId  String
  labelId String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model Checklist {
  id       String          @id @default(cuid())
  cardId   String
  card     Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title    String
  position String // fractional index
  items    ChecklistItem[]

  @@index([cardId, position])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean   @default(false)
  position    String // fractional index

  @@index([checklistId, position])
}

// OAuth 2.1 authorization server for the remote MCP endpoint. Secrets are
// stored as SHA-256 hashes, never in clear.

model OAuthClient {
  id           String   @id // random id (DCR) or https URL (client ID metadata document)
  name         String
  redirectUris String[]
  secretHash   String?
  createdAt    DateTime @default(now())
}

model OAuthCode {
  codeHash      String   @id
  clientId      String
  email         String
  redirectUri   String
  codeChallenge String
  scope         String
  resource      String
  expiresAt     DateTime
}

model OAuthToken {
  id               String   @id @default(cuid())
  clientId         String
  clientName       String
  email            String
  scope            String
  resource         String
  accessTokenHash  String   @unique
  accessExpiresAt  DateTime
  refreshTokenHash String   @unique
  refreshExpiresAt DateTime
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())

  @@index([refreshExpiresAt])
}

// App-wide settings (single user), e.g. the iCal feed version.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Change log of every mutation, from the UI or from Claude (MCP), with the
// inverse operations needed to undo it.
model Activity {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  actor     String // "user" | "claude"
  kind      String // e.g. "card.update"
  summary   String
  boardId   String?
  cardId    String?
  /// Ids of the records touched, to detect later conflicting changes.
  entityIds String[]
  /// UndoOp[] (see src/server/activity.ts); null when it cannot be undone.
  undo      Json?
  undoneAt  DateTime?

  @@index([createdAt])
  @@index([boardId, createdAt])
  @@index([cardId, createdAt])
}

// Reusable board or card structure (see src/lib/templates.ts for `data`).
model Template {
  id        String   @id @default(cuid())
  kind      String // "board" | "card"
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, name])
}

// File attached to a card. `url` is a private Vercel Blob URL, or "local:<key>"
// with the local storage driver (development and tests).
model Attachment {
  id          String   @id @default(cuid())
  cardId      String
  card        Card     @relation("CardAttachments", fields: [cardId], references: [id], onDelete: Cascade)
  coverOf     Card?    @relation("CardCover")
  name        String
  url         String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  @@index([cardId, createdAt])
}

// KDP publishing calendar: weekly tasks in two lanes (main and secondary
// account), independent from boards.
model KdpTask {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  /// "main" | "secondary". Checked in the database.
  account   String
  /// "planned" (Pianificato) | "actual" (Reale): the sub-lane within the account. Checked in the database.
  track     String   @default("planned")
  /// Sunday of the task's week (date only).
  week      DateTime @db.Date
  position  String // fractional index within (week, account, track)
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([week, account, track, position])
}

// Books of a KDP account, imported from the Bookshelf (titles, formats, ASINs),
// linked to the board cards about them.
model KdpBook {
  id           String            @id @default(cuid())
  /// "main" | "secondary". Checked in the database.
  account      String
  /// Bookshelf title id (the row id on kdp.amazon.com).
  kdpId        String
  title        String
  series       String?
  /// KdpBookFormat[] (see src/lib/kdp-books.ts): status, ASIN, price, link.
  formats      Json
  /// Set when the last import of the account no longer listed the book.
  missingSince DateTime?
  importedAt   DateTime
  /// Volume number in its series, set by hand; null = read from the title.
  volume       Int?
  links        KdpBookLink[]
  aliases      KdpTitleAlias[]
  prices       KdpPriceHistory[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([account, kdpId])
}

/// Card-book link: "confirmed" (by the user, or automatically for a certain
/// match), "suggested" (waiting for confirmation) or "rejected" (never proposed again).
model KdpBookLink {
  id        String   @id @default(cuid())
  bookId    String
  book      KdpBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// "confirmed" | "suggested" | "rejected". Checked in the database.
  status    String
  /// Confirmed by the matcher, not by the user.
  auto      Boolean  @default(false)
  score     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, cardId])
  @@index([cardId])
  @@index([status])
}

// Daily sales of one title family (DIGITAL/PRINT/HARDCOVER ASINs) in one
// marketplace, from the KDP Reports pages. Royalties are KDP's estimates in EUR.
model KdpSale {
  id               String   @id @default(cuid())
  /// "main" | "secondary". Checked in the database.
  account          String
  date             DateTime @db.Date
  /// "Amazon.it", "Amazon.com", ...
  marketplace      String
  /// KDP's title key, e.g. "DIGITAL=B0..:PRINT=B0..:HARDCOVER=:".
  titleKey         String
  ebookAsin        String?
  paperbackAsin    String?
  hardcoverAsin    String?
  ebookUnits       Int      @default(0)
  paperbackUnits   Int      @default(0)
  hardcoverUnits   Int      @default(0)
  kenp             Int      @default(0)
  royalty          Float    @default(0)
  royaltyEbook     Float    @default(0)
  royaltyPaperback Float    @default(0)
  royaltyHardcover Float    @default(0)
  royaltyKenp      Float    @default(0)

  @@unique([account, date, marketplace, titleKey])
  @@index([date])
}

// Title family of the sales reports (titleKey) that no imported book owns,
// named by hand: either an existing book or a free title.
model KdpTitleAlias {
  id        String   @id @default(cuid())
  /// "main" | "secondary". Checked in the database.
  account   String
  titleKey  String
  bookId    String?
  book      KdpBook? @relation(fields: [bookId], references: [id], onDelete: SetNull)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([account, titleKey])
}

// Daily Amazon Ads spend per advertised ASIN, from the "Advertised product"
// report of the Ads console (one console, and currency, per marketplace).
model KdpAdSpend {
  id          String   @id @default(cuid())
  /// "main" | "secondary". Checked in the database.
  account     String
  date        DateTime @db.Date
  /// ISO 4217 code of the report; spend and sales are in it.
  currency    String
  campaign    String
  asin        String
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Float    @default(0)
  /// Sales attributed by Amazon (7 or 14 days), report currency.
  sales       Float    @default(0)
  orders      Int      @default(0)

  @@unique([account, date, currency, campaign, asin])
  @@index([date])
  @@index([asin])
}

// A list price seen on the Bookshelf: one row per change, per book and format.
model KdpPriceHistory {
  id     String   @id @default(cuid())
  bookId String
  book   KdpBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// "ebook" | "paperback" | "hardcover"
  format String
  /// Price text as shown by KDP, e.g. "€4,99 EUR".
  price  String
  market String?
  seenAt DateTime

  @@index([bookId, format, seenAt])
}

// Robotti e Robotte: editorial calendar of the satirical channel. A piece
// (scheda) goes out on a date and time slot, with one layer per platform.
model ContentRubric {
  /// Stable key, e.g. "il-trono".
  value    String         @id
  name     String
  /// "#RRGGBB"
  color    String
  position Int            @default(0)
  pieces   ContentPiece[]
}

model ContentPiece {
  id              String           @id @default(cuid())
  /// Stable code chosen by Claude, e.g. "ep002": the key of every MCP operation.
  code            String           @unique
  title           String
  rubric          String
  rubricRef       ContentRubric    @relation(fields: [rubric], references: [value], onUpdate: Cascade)
  releaseDate     DateTime         @db.Date
  /// "13:00" | "19:00". Checked in the database.
  slot            String
  /// Manual status: idea … pronto, or scartato ("programmato"/"pubblicato" come from the layers).
  status          String           @default("idea")
  /// "A" | "B" | "C" | "D" when overridden; null = computed from the date.
  cycleWeek       String?
  durationSeconds Int?
  /// "9:16" | "16:9" | "immagini"
  videoFormat     String?
  summary         String?
  videoFile       String?
  coverFile       String?
  script          String?
  question        String?
  voteOptions     String[]         @default([])
  voteResult      String?
  voteCloses      DateTime?        @db.Date
  notes           String?
  /// "rosario" | "claude"
  createdBy       String
  updatedBy       String
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  layers          ContentLayer[]
  history         ContentHistory[]

  @@index([releaseDate, slot])
}

model ContentLayer {
  id                String          @id @default(cuid())
  pieceId           String
  piece             ContentPiece    @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  /// "tiktok" | "youtube" | "instagram". Checked in the database.
  platform          String
  active            Boolean         @default(true)
  /// "da preparare" | "pronto" | "programmato" | "pubblicato" | "problema"
  publishStatus     String          @default("da preparare")
  plannedAt         DateTime?
  /// Set when plannedAt was moved by hand: moving the piece leaves it alone.
  plannedAtManual   Boolean         @default(false)
  publishedAt       DateTime?
  url               String?
  aiLabel           Boolean         @default(false)
  coverChosen       Boolean         @default(false)
  pinnedComment     String?
  pinnedCommentDone Boolean         @default(false)
  /// { [option]: count }
  votes             Json            @default("{}")
  /// Platform fields (see src/lib/content.ts): caption, YouTube title, …
  details           Json            @default("{}")
  notes             String?
  metrics           ContentMetric[]

  @@unique([pieceId, platform])
}

/// One reading of a layer's numbers; readings accumulate.
model ContentMetric {
  id           String       @id @default(cuid())
  layerId      String
  layer        ContentLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  measuredAt   DateTime
  views        Int?
  likes        Int?
  comments     Int?
  shares       Int?
  saves        Int?
  completion   Float?
  newFollowers Int?
  watchHours   Float?
  createdAt    DateTime     @default(now())

  @@index([layerId, measuredAt])
}

model ContentHistory {
  id      String       @id @default(cuid())
  pieceId String
  piece   ContentPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  /// "rosario" | "claude"
  actor   String
  summary String
  at      DateTime     @default(now())

  @@index([pieceId, at])
}
